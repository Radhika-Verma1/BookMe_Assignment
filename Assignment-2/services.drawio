<mxfile host="Electron" modified="2026-10-13T13:30:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="bookme_services" name="BookMe Services Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title Banner -->
        <mxCell id="title_banner" value="&lt;b&gt;BookMe — Microservice Architecture &amp; Service Contracts Benchmark&lt;/b&gt;&#xa;CS 543 Web Services · Assignment 2 · Team 11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#495057;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="700" height="45" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- SERVICES (BOXES)                           -->
        <!-- ========================================== -->
        
        <!-- Auth Service -->
        <mxCell id="auth_svc" value="&lt;b&gt;Auth Service&lt;/b&gt;&#xa;&lt;i&gt;Lead: Radhika Verma (20251651075)&lt;/i&gt;&#xa;────────────────────────&#xa;&lt;b&gt;Owns Data:&lt;/b&gt;&#xa;• users&#xa;• user_credentials&#xa;• user_sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="220" height="120" as="geometry" />
        </mxCell>
        
        <!-- Vendor Service -->
        <mxCell id="vendor_svc" value="&lt;b&gt;Vendor Service&lt;/b&gt;&#xa;&lt;i&gt;Lead: Nandini Kanaujiya (20251651061)&lt;/i&gt;&#xa;────────────────────────&#xa;&lt;b&gt;Owns Data:&lt;/b&gt;&#xa;• vendors&#xa;• services&#xa;• packages&#xa;• availability (calendar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="110" width="240" height="130" as="geometry" />
        </mxCell>
        
        <!-- Event & Booking Service (Central) -->
        <mxCell id="booking_svc" value="&lt;b&gt;Event &amp; Booking Service&lt;/b&gt;&#xa;&lt;i&gt;Lead: Alka Jha (20251651013)&lt;/i&gt;&#xa;────────────────────────&#xa;&lt;b&gt;Owns Data:&lt;/b&gt;&#xa;• events&#xa;• bookings&#xa;• checklist_items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="300" width="260" height="130" as="geometry" />
        </mxCell>
        
        <!-- Payment & Feedback Service -->
        <mxCell id="payment_svc" value="&lt;b&gt;Payment &amp; Feedback Service&lt;/b&gt;&#xa;&lt;i&gt;Lead: Alok Mishra (20251651014)&lt;/i&gt;&#xa;────────────────────────&#xa;&lt;b&gt;Owns Data:&lt;/b&gt;&#xa;• payments&#xa;• payouts&#xa;• reviews&#xa;• complaints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="550" width="260" height="130" as="geometry" />
        </mxCell>
        
        <!-- ========================================== -->
        <!-- CONNECTORS (CROSS-SERVICE ARROWS)          -->
        <!-- ========================================== -->
        
        <!-- Booking Svc -> Auth Svc (verifyCustomer) -->
        <mxCell id="conn_booking_auth" value="verifyCustomer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.15;exitY=0;exitDx=0;exitDy=0;strokeColor=#2b579a;strokeWidth=2;fontSize=11;fontColor=#2b579a;" edge="1" parent="1" source="booking_svc" target="auth_svc">
          <mxGeometry relative="1" as="geometry">
            <Array points="480, 260", "230, 260" />
          </mxGeometry>
        </mxCell>
        
        <!-- Booking Svc -> Vendor Svc (checkAvailability) -->
        <mxCell id="conn_booking_vendor_check" value="checkAvailability" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=1;entryDx=0;entryDy=0;exitX=0.85;exitY=0;exitDx=0;exitDy=0;strokeColor=#2d7d32;strokeWidth=2;fontSize=11;fontColor=#2d7d32;" edge="1" parent="1" source="booking_svc" target="vendor_svc">
          <mxGeometry relative="1" as="geometry">
            <Array points="660, 270", "840, 270" />
          </mxGeometry>
        </mxCell>
        
        <!-- Booking Svc -> Vendor Svc (reserveSlot) -->
        <mxCell id="conn_booking_vendor_reserve" value="reserveSlot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.65;entryY=1;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#2d7d32;strokeWidth=2;dashed=1;fontSize=11;fontColor=#2d7d32;" edge="1" parent="1" source="booking_svc" target="vendor_svc">
          <mxGeometry relative="1" as="geometry">
            <Array points="936, 365" />
          </mxGeometry>
        </mxCell>
        
        <!-- Booking Svc -> Payment Svc (initiatePayment) -->
        <mxCell id="conn_booking_payment" value="initiatePayment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.35;entryY=0;entryDx=0;entryDy=0;exitX=0.35;exitY=1;exitDx=0;exitDy=0;strokeColor=#b85450;strokeWidth=2;fontSize=11;fontColor=#b85450;" edge="1" parent="1" source="booking_svc" target="payment_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Payment Svc -> Booking Svc (updateBookingStatus) -->
        <mxCell id="conn_payment_booking" value="updateBookingStatus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.65;entryY=1;entryDx=0;entryDy=0;exitX=0.65;exitY=0;exitDx=0;exitDy=0;strokeColor=#d6b656;strokeWidth=2;dashed=1;fontSize=11;fontColor=#b78103;" edge="1" parent="1" source="payment_svc" target="booking_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Payment Svc -> Vendor Svc (getVendorPayoutAccount) -->
        <mxCell id="conn_payment_vendor" value="getVendorPayoutAccount" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.9;entryY=1;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#795548;strokeWidth=2;fontSize=11;fontColor=#795548;" edge="1" parent="1" source="payment_svc" target="vendor_svc">
          <mxGeometry relative="1" as="geometry">
            <Array points="996, 615" />
          </mxGeometry>
        </mxCell>

        <!-- Policy Note Box -->
        <mxCell id="note_boundary" value="&lt;b&gt;Service Boundary Rules:&lt;/b&gt;&#xa;1. Absolute Data Ownership: No table is shared across services.&#xa;2. Network Contracts Only: Cross-service interactions happen via REST APIs.&#xa;3. Idempotent &amp; Decoupled: Cross-boundary references use immutable UUIDs/strings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="550" width="280" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
